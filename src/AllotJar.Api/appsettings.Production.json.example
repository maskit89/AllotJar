{
  "//": "TEMPLATE - copy to 'appsettings.Production.json' ON THE SERVER ONLY and fill in real values. Never commit the filled-in file (it is gitignored). The deploy script preserves it across redeploys (robocopy /XF).",

  "ConnectionStrings": {
    "//": "SQL Server Express on the same box. Trusted_Connection uses the API app-pool identity (IIS APPPOOL\\ZeroBudget-Api), which Setup-Database.sql grants db_owner - so there is no DB password to store. Adjust the instance name (\\SQLEXPRESS) if you installed a default instance.",
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=ZeroBudget;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "//": "Generate a long random secret (>=32 bytes). e.g. PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))",
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES"
  },

  "Cors": {
    "//": "Not strictly needed since the SPA is served same-origin via the IIS proxy, but set it to your real domain for safety.",
    "AllowedOrigins": [ "https://your-domain.example" ]
  },

  "Email": {
    "//": "Provider is 'cloudflare' (Cloudflare Email Service) or 'resend'; blank defaults to resend. The sending domain must be onboarded/verified with the chosen provider or sends are rejected. Without an ApiKey, password-reset emails are NOT sent (only logged as a warning) - the startup log states which provider resolved.",
    "Provider": "cloudflare",
    "//ApiKey": "Cloudflare: an API token with the 'Email Sending: Edit' permission. Resend: the API key.",
    "ApiKey": "REPLACE_WITH_PROVIDER_API_TOKEN",
    "//AccountId": "Cloudflare ONLY - its send endpoint is account-scoped (/client/v4/accounts/{id}/email/sending/send). Omit for Resend.",
    "AccountId": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "FromAddress": "AllotJar <no-reply@allotjar.com>",
    "AppBaseUrl": "https://www.allotjar.com"
  },

  "DataProtection": {
    "//": "Persistent folder for the DataProtection key ring (grant the API app-pool identity modify rights). Without it, emailed password-reset links die on every app restart/deploy.",
    "KeysPath": "C:\\inetpub\\zerobudget-dp-keys"
  }
}
